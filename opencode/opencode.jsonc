{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    "github:rumisle/opencode-anth#d92862ebcdbee624039a94a30ea50de77a1b1cb6",
    { "package": "github:rumisle/opencode-cache-warmer#688d10287ad9f9c22a578628674870c9e3e5683d", "options": { "mode": "idle" } },
    "github:rumisle/opencode-vcc#81331e719109973a7ef816041b1116ff64a4b790",
    "github:rumisle/opencode-octopi#badd61ef961e0820101f03d2da33bf7d5fd2151d"
  ],
  "permissions": [
    { "action": "question", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "*list_mcp_resources", "resource": "*", "effect": "deny" },
    { "action": "*read_mcp_resource", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" }
  ],
  "agents": {
    "plan": { "disabled": true },
    "general": { "disabled": true },
    "explore": { "disabled": true }
  }
}
